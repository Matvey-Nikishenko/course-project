{
  "name": "marketplace-api",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace API — Node.js PRO course project",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/main.js",
    "start:dev": "nest start --watch",
    "check:env": "npm run build --silent && node scripts/check-env-example.mjs",
    "db:up": "bash db/up.sh",
    "db:down": "docker compose down -v",
    "rotate": "bash rotate.sh",
    "lint:spec": "redocly lint openapi/openapi.yaml",
    "bundle:spec": "redocly bundle openapi/openapi.yaml -o spec.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express-openapi-validator": "5.6.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@redocly/cli": "2.46.0",
    "@types/express": "5.0.0",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
