# ─── Configuration contract ──────────────────────────────────────────────
# This file lives in git and lists EVERY variable from src/config/env.schema.ts.
# Real values live in .env, which is git-ignored.
#
#   cp .env.example .env      ← first step after cloning
#
# Rules:
#   1. Every variable of the app is here, optional ones included.
#   2. Secret values here are fake. Never real ones.
#   3. Added a variable to the schema → add it here IN THE SAME COMMIT,
#      otherwise `npm run check:env` fails and a teammate's app will not start.

# HTTP port of the API. Optional, defaults to 3000.
PORT=3000

# Log verbosity: debug | info | warn | error. Optional, defaults to info.
LOG_LEVEL=info

# Postgres connection descriptor. REQUIRED — the app refuses to start without it.
# Deliberately carries no password: the schema rejects a URL that has one,
# because the password is a rotatable secret and belongs in a file.
# Host/port are PgBouncer (compose service `pgbouncer`, published 6432), not
# the raw Postgres 5433. Scripts (backup / restore-drill) take DATABASE_URL
# from the HW#11 store; that key is not in this contract — see ## Grading.
DB_URL=postgres://app_user@127.0.0.1:6432/marketplace

# Path to the file holding the database password, relative to the working
# directory. Optional, defaults to secrets/db_password.
# In production this path is a mounted secret (K8s Secret volume, Docker
# secret), not a file in the repository.
DB_PASSWORD_FILE=secrets/db_password

# Maximum connections in the pg pool. Optional, defaults to 5.
DB_POOL_MAX=5

# RabbitMQ AMQP URL. Optional: without a real one, checkout does not publish.
# The live value comes from the HW#11 store, next to the database connection.
# USER:PASSWORD is a placeholder, not the compose account. Dev stand (see
# ## Grading) is amqp://app:app@127.0.0.1:5672 — port 5672 is AMQP, not 15672.
BROKER_URL=amqp://USER:PASSWORD@127.0.0.1:5672

# Redis for the product-card cache. Optional. USER:PASSWORD is a placeholder,
# not a compose account. The cache container is allkeys-lru with a memory cap.
# Dev stand (see ## Grading) is redis://127.0.0.1:6379.
REDIS_URL=redis://USER:PASSWORD@127.0.0.1:6379

# Redis for BullMQ, sessions, and the shared rate-limit counter. Optional.
# This container is noeviction. It is a different process from REDIS_URL.
# Dev stand is redis://127.0.0.1:6380.
REDIS_QUEUE_URL=redis://USER:PASSWORD@127.0.0.1:6380

# Access-token signing key. REQUIRED. No default. The value is base64 of a
# PKCS#8 PEM (ES256), from the HW#11 store, not from this file.
# BASE64_PKCS8 is a placeholder. It is not a key.
JWT_KID=local
JWT_PRIVATE_KEY=BASE64_PKCS8
JWT_PUBLIC_KEY=BASE64_SPKI

# HMAC pepper for refresh-token hashes. REQUIRED. From the HW#11 store.
REFRESH_TOKEN_PEPPER=replace-me-from-the-store
