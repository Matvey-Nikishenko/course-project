# ─── Configuration contract ──────────────────────────────────────────────
# This file lives in git and lists EVERY variable from src/config/env.schema.ts.
# Real values live in .env, which is git-ignored.
#
#   cp .env.example .env      ← first step after cloning
#
# Rules:
#   1. Every variable of the app is here, optional ones included.
#   2. Secret values here are fake. Never real ones.
#   3. Added a variable to the schema → add it here IN THE SAME COMMIT,
#      otherwise `npm run check:env` fails and a teammate's app will not start.

# HTTP port of the API. Optional, defaults to 3000.
PORT=3000

# Log verbosity: debug | info | warn | error. Optional, defaults to info.
LOG_LEVEL=info

# Postgres connection descriptor. REQUIRED — the app refuses to start without it.
# Deliberately carries no password: the schema rejects a URL that has one,
# because the password is a rotatable secret and belongs in a file.
DB_URL=postgres://app_user@127.0.0.1:5433/marketplace

# Path to the file holding the database password, relative to the working
# directory. Optional, defaults to secrets/db_password.
# In production this path is a mounted secret (K8s Secret volume, Docker
# secret), not a file in the repository.
DB_PASSWORD_FILE=secrets/db_password

# Maximum connections in the pg pool. Optional, defaults to 5.
DB_POOL_MAX=5
